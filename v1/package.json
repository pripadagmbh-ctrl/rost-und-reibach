{
  "name": "schrottplatz-v1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run typecheck:test",
    "test": "vitest run",
    "ton:werkzeug": "node tools/tonwerk/werkzeug-einrichten.mjs",
    "icons": "node ../tools/make-icons.mjs",
    "android:add": "npm run build && npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/three": "^0.169.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
